---
import { Button } from 'animal-island-ui/es/components/Button/Button.js';
import { Card } from 'animal-island-ui/es/components/Card/Card.js';
import { Icon } from 'animal-island-ui';
import { Tag } from 'animal-island-ui/es/components/Tag/Tag.js';
import '../styles/home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import IslanderPickerModal from '../components/IslanderPickerModal.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getCategorySummaries } from '../lib/category';
import { getFeaturedExhibition } from '../lib/exhibitions';
import { categoryColor, formatDate, getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
const trailPosts = posts.slice(0, 5);
const categories = getCategorySummaries(posts);
const featuredExhibition = await getFeaturedExhibition();

const trailItems = ['star-wand', 'flower', 'fish', 'bell-bag', 'coin'];
const trailColors = ['app-yellow', 'app-pink', 'app-blue', 'app-orange', 'app-green'] as const;
---

<BaseLayout bodyClass="home-page">
  <section
    class="home-hero"
    aria-labelledby="home-title"
  >
    <div class="home-hero__texture" aria-hidden="true"></div>
    <div class="home-hero__rings" aria-hidden="true"></div>

    <div class="home-hero__inner shell">
      <div class="home-hero__copy">
        <p class="home-hero__kicker">INEXISTENCE ISLAND · OPEN SINCE 2015</p>
        <h1 id="home-title"><span>IN</span><span>EXISTENCE</span></h1>
        <p class="home-hero__saying">登岛手续办好啦！随便逛逛吧！</p>
        <p class="home-hero__lead">这里收着一些技术笔记、生活碎片，还有舍不得忘记的旧事。</p>
        <form action="#island-trail">
          <Button type="primary" size="large" htmlType="submit">开始逛岛 <span aria-hidden="true">→</span></Button>
        </form>
      </div>

      <div class="home-hero__scene-wrap">
        <div class="home-hero__scene" aria-label="两位狸猫岛民欢迎你登岛">
          <div class="home-hero__sun" aria-hidden="true"></div>
          <ResponsiveImage
            class="home-hero__animal"
            src="/assets/animal-island-ui/animal-icon.webp"
            alt="两位狸猫岛民"
            sizes="(max-width: 760px) 112vw, min(52vw, 687px)"
            loading="eager"
          />
          <ResponsiveImage class="hero-float hero-float--star" src="/assets/animal-island-ui/star-wand.webp" alt="" ariaHidden fixedWidth={128} />
          <ResponsiveImage class="hero-float hero-float--flower" src="/assets/animal-island-ui/flower.webp" alt="" ariaHidden fixedWidth={96} />
          <ResponsiveImage class="hero-float hero-float--coin" src="/assets/animal-island-ui/coin.webp" alt="" ariaHidden fixedWidth={128} />
          <span class="home-hero__stamp" aria-hidden="true">WELCOME<br />ASHORE</span>
        </div>
      </div>
    </div>

    <a class="home-hero__scroll" href="#island-trail">
      <span>沿小路往下</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 4v15m-6-6 6 6 6-6" /></svg>
    </a>
  </section>

  <section class="island-trail" id="island-trail">
    <div class="island-trail__pattern" aria-hidden="true"></div>
    <header class="trail-heading shell" data-reveal>
      <p class="eyebrow">ISLAND LOGBOOK · {String(trailPosts.length).padStart(2, '0')} STOPS</p>
      <h2>从最近一篇出发，<br />慢慢走回从前。</h2>
      <p>文章按写下的时间排成一条小路。沿着路牌慢慢走，想从哪里开始都可以。</p>
    </header>

    <div class="trail-map shell">
      <div class="trail-map__line" aria-hidden="true"></div>
      {trailPosts.map((post, index) => {
        const color = trailColors[index % trailColors.length];
        return (
          <article class:list={['trail-stop', { 'trail-stop--reverse': index % 2 === 1 }]} data-reveal style={`--stop-index:${index}`}>
            <div class="trail-stop__marker" aria-hidden="true">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <ResponsiveImage src={`/assets/animal-island-ui/${trailItems[index % trailItems.length]}.webp`} alt="" fixedWidth={64} />
            </div>
            <a class="trail-stop__link" href={`/posts/${post.id}/`} aria-label={`阅读《${post.data.title}》`}>
              <Card color={color} pattern={index === 0 ? color : 'none'} hoverable className="trail-stop__card">
                {post.data.cover && (
                  <ResponsiveImage
                    class="trail-stop__cover"
                    src={post.data.cover}
                    alt=""
                    loading={index === 0 ? 'eager' : 'lazy'}
                    sizes="(max-width: 760px) calc(100vw - 116px), 240px"
                  />
                )}
                <div class="trail-stop__body">
                  <div class="trail-stop__meta">
                    <Tag size="small" variant="solid" color={categoryColor(post.data.category)}>{post.data.category}</Tag>
                    <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
                  </div>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                  <span class="trail-stop__more">停下来读读 <span aria-hidden="true">↗</span></span>
                </div>
              </Card>
            </a>
          </article>
        );
      })}
    </div>

    <div class="trail-action shell" data-reveal>
      <form action="/archive/">
        <Button type="default" size="large" htmlType="submit">翻开完整岛志</Button>
      </form>
    </div>
  </section>

  <section class="island-directory">
    <div class="island-directory__inner shell">
      <div class="island-directory__copy" data-reveal>
        <p class="eyebrow">ISLAND DIRECTORY</p>
        <h2>今天想去岛上哪一边？</h2>
        <p>去技术区翻翻工具箱，去日志区听听旧故事；也可以不选方向，继续散步。</p>
      </div>
      <div class="directory-apps">
        {categories.map((category, index) => (
          <a href={category.href} class="directory-app" data-reveal style={`--app-index:${index}`}>
            <span class="directory-app__icon">
              <Icon name={category.icon} size="100%" aria-hidden="true" />
            </span>
            <strong>{category.name}</strong>
            <small>{category.count} 篇记录</small>
          </a>
        ))}
      </div>
    </div>
  </section>

  {featuredExhibition && (
    <section class="exhibition-promo shell" data-reveal aria-labelledby="exhibition-promo-title">
      <ResponsiveImage
        class="exhibition-promo__image"
        src={featuredExhibition.data.cover}
        alt=""
        ariaHidden
        sizes="(max-width: 760px) calc(100vw - 40px), 440px"
      />
      <div class="exhibition-promo__copy">
        <p class="eyebrow">ISLAND EXHIBITION · NOW OPEN</p>
        <h2 id="exhibition-promo-title">{featuredExhibition.data.title}</h2>
        <p>{featuredExhibition.data.description}</p>
        <a class="exhibition-promo__link" href={`/exhibitions/${featuredExhibition.id}/`} data-home-exhibition-picker-trigger>
          选两位岛民一起逛 <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
    <IslanderPickerModal id="home-exhibition-islander-picker" />
  )}

  <script is:inline data-astro-rerun>
    (() => {
      const modal = document.querySelector('[data-islander-picker-modal="home-exhibition-islander-picker"]');
      const trigger = document.querySelector('[data-home-exhibition-picker-trigger]');
      if (!(modal instanceof HTMLDialogElement) || !(trigger instanceof HTMLAnchorElement)) return;
      const controller = new AbortController();

      trigger.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        modal.dispatchEvent(new CustomEvent('islander-picker:open', { detail: { reset: true } }));
        if (!modal.open) modal.showModal();
      }, { signal: controller.signal });
      modal.addEventListener('islander-picker:confirm', (event) => {
        const selected = event instanceof CustomEvent ? event.detail?.selected : null;
        if (!Array.isArray(selected) || selected.length !== 2) return;
        const target = new URL(trigger.href);
        target.searchParams.set('companions', selected.join(','));
        window.location.assign(`${target.pathname}${target.search}`);
      }, { signal: controller.signal });
      document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    })();
  </script>

  <script is:inline data-astro-rerun>
    (() => {
      const hero = document.querySelector('.home-hero');
      if (!(hero instanceof HTMLElement)) return;

      if (!('IntersectionObserver' in window)) {
        hero.classList.add('is-animating');
        return;
      }

      const observer = new IntersectionObserver(([entry]) => {
        hero.classList.toggle('is-animating', entry.isIntersecting);
      });

      observer.observe(hero);
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    })();
  </script>

</BaseLayout>
