---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryTrailNav from '../../components/CategoryTrailNav.astro';
import CategoryPostCard from '../../components/CategoryPostCard.astro';
import { getCategorySummaries, type CategorySummary } from '../../lib/category';
import { categoryColor, getPublishedPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = getCategorySummaries(posts);
  return categories.map(({ name: category }) => ({
    params: { category },
    props: { category, posts: posts.filter((post) => post.data.category === category), categories },
  }));
}

interface Props {
  category: string;
  posts: Post[];
  categories: CategorySummary[];
}

const { category, posts, categories } = Astro.props;
const color = categoryColor(category);
---

<BaseLayout title={`${category}分类`} description={`INEXISTENCE 中的${category}文章。`}>
  <header class:list={['page-hero', 'page-hero--category', `page-hero--${color}`]}>
    <div class="shell page-hero__inner" data-reveal>
      <p class="eyebrow">CATEGORY</p>
      <h1>{category}小径</h1>
      <p>这里一共有 {posts.length} 篇文章。</p>
    </div>
  </header>

  <section class="shell section category-list">
    <div class="category-trail-layout">
      <aside class="category-trail-aside" data-reveal>
        <a class="category-trail-aside__back" href="/archive/">← 返回完整岛志</a>
        <p>换一条小径</p>
        <CategoryTrailNav categories={categories} currentCategory={category} variant="aside" />
      </aside>
      <div class="category-post-list">
        {posts.map((post, index) => <CategoryPostCard post={post} index={index} />)}
      </div>
    </div>
  </section>
</BaseLayout>
