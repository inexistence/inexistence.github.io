---
import { Button } from 'animal-island-ui/es/components/Button/Button.js';
import BaseLayout from '../../layouts/BaseLayout.astro';
import IslanderPickerModal from '../../components/IslanderPickerModal.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import '../../styles/exhibitions.css';
import { getPublishedExhibitions } from '../../lib/exhibitions';

const exhibitions = await getPublishedExhibitions();
---

<BaseLayout title="岛屿展厅" description="和两位岛民一起，慢慢看完一组摄影作品。" bodyClass="exhibitions-page">
  <section class="exhibition-index shell" aria-labelledby="exhibition-index-title">
    <header class="exhibition-index__heading">
      <p class="eyebrow">ISLAND EXHIBITION</p>
      <h1 id="exhibition-index-title">岛屿展厅</h1>
      <p>每一期展览都是一段慢慢经过的路。选两位岛民，和他们一起看完一组照片。</p>
    </header>

    {exhibitions.length ? (
      <div class="exhibition-index__list">
        {exhibitions.map((exhibition) => (
          <article class="exhibition-card" data-reveal>
            <ResponsiveImage
              class="exhibition-card__image"
              src={exhibition.data.cover}
              alt=""
              ariaHidden
              sizes="(max-width: 760px) calc(100vw - 40px), 540px"
            />
            <div class="exhibition-card__body">
              <p class="eyebrow">CURRENT EXHIBITION</p>
              <h2>{exhibition.data.title}</h2>
              <p>{exhibition.data.description}</p>
              <a class="exhibition-card__link" href={`/exhibitions/${exhibition.id}/`} data-exhibition-picker-trigger>
                进入展厅 <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <section class="exhibition-empty" aria-labelledby="exhibition-empty-title">
        <div class="exhibition-empty__token" aria-hidden="true">✦</div>
        <div>
          <h2 id="exhibition-empty-title">展厅正在布展</h2>
          <p>第一组照片正在等待挂上墙。过些时候再来走走吧。</p>
        </div>
        <form action="/">
          <Button type="default" htmlType="submit">先回岛上逛逛</Button>
        </form>
      </section>
    )}
  </section>
  <IslanderPickerModal id="exhibition-islander-picker" />

  <script is:inline data-astro-rerun>
    (() => {
      const modal = document.querySelector('[data-islander-picker-modal="exhibition-islander-picker"]');
      if (!(modal instanceof HTMLDialogElement)) return;
      const controller = new AbortController();
      let destination = '';

      document.querySelectorAll('[data-exhibition-picker-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          if (!(trigger instanceof HTMLAnchorElement) || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          destination = trigger.href;
          modal.dispatchEvent(new CustomEvent('islander-picker:open', { detail: { reset: true } }));
        }, { signal: controller.signal });
      });
      modal.addEventListener('islander-picker:confirm', (event) => {
        const selected = event instanceof CustomEvent ? event.detail?.selected : null;
        if (!destination || !Array.isArray(selected) || selected.length !== 2) return;
        const target = new URL(destination);
        target.searchParams.set('companions', selected.join(','));
        window.location.assign(`${target.pathname}${target.search}`);
      }, { signal: controller.signal });
      document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });
    })();
  </script>
</BaseLayout>
