---
import { Icon } from 'animal-island-ui';
import type { CategorySummary } from '../lib/category';

interface Props {
  categories: CategorySummary[];
  currentCategory?: string;
  variant?: 'archive' | 'aside';
}

const { categories, currentCategory, variant = 'archive' } = Astro.props;
---

<nav class:list={['category-trail-nav', `category-trail-nav--${variant}`]} aria-label="主题小径">
  <ul>
    {categories.map((category) => (
      <li>
        <a
          class:list={['category-trail-nav__link', `category-trail-nav__link--${category.color}`]}
          href={category.href}
          aria-current={currentCategory === category.name ? 'page' : undefined}
          aria-label={currentCategory === category.name ? `当前正在浏览${category.name}小径，共${category.count}篇文章` : `前往${category.name}小径，共${category.count}篇文章`}
        >
          <Icon name={category.icon} size="100%" aria-hidden="true" />
          <span>{variant === 'archive' ? `${category.name}小径` : category.name}</span>
          <small>
            {category.count} 篇
            {currentCategory === category.name && <span>当前</span>}
          </small>
        </a>
      </li>
    ))}
  </ul>
</nav>
