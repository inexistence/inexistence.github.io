---
interface Props {
  path: string;
  label?: string;
  emailHint?: string;
}

const {
  path,
  label = '评论区',
  emailHint,
} = Astro.props;
const serverURL = import.meta.env.PUBLIC_WALINE_SERVER_URL;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<div
  class="waline-host"
  aria-label={label}
  aria-busy={serverURL ? 'true' : 'false'}
  data-waline
  data-waline-host
  data-waline-path={path}
  data-waline-server-url={serverURL}
  data-waline-turnstile-key={turnstileKey}
  data-waline-email-hint={emailHint}
>
  <p class="waline-host__message" data-waline-message aria-live="polite">
    {serverURL ? '留言区正在靠岸…' : '留言区正在准备中，稍后再来看看吧。'}
  </p>
  <noscript><p class="waline-host__message">请启用 JavaScript 后查看和参与留言。</p></noscript>
</div>

<script>
  type WalineInstance = ReturnType<typeof import('@waline/client').init>;

  let instance: WalineInstance = null;
  let mountedHost: HTMLElement | null = null;
  let stopTurnstileCleanup: (() => void) | null = null;
  let observer: IntersectionObserver | null = null;
  let observedHost: HTMLElement | null = null;
  let mountingHost: HTMLElement | null = null;
  let mountPromise: Promise<void> | null = null;
  let mountGeneration = 0;
  let walineClient: Promise<typeof import('@waline/client')> | null = null;

  const clearTurnstile = (editor: HTMLTextAreaElement) => {
    editor.closest('.wl-panel')?.querySelector('.wl-captcha-container')?.replaceChildren();
  };

  const applyEmailHint = (host: HTMLElement) => {
    const emailHint = host.dataset.walineEmailHint;
    if (!emailHint) return;

    const emailInput = [...host.querySelectorAll<HTMLInputElement>('.wl-header input')].find(
      (input) => input.name === 'mail' || input.type === 'email',
    );

    emailInput?.setAttribute('placeholder', emailHint);
  };

  const watchForSuccessfulSubmission = (host: HTMLElement, editor: HTMLTextAreaElement) => {
    stopTurnstileCleanup?.();

    const cards = host.querySelector('.wl-cards');
    const initialCommentCount = cards?.querySelectorAll('.wl-card-item').length ?? 0;
    let checks = 0;

    const timer = window.setInterval(() => {
      const commentCount = cards?.querySelectorAll('.wl-card-item').length ?? 0;

      // Waline only clears the editor and adds the submitted comment after its API call succeeds.
      if (!editor.value && commentCount > initialCommentCount) {
        clearTurnstile(editor);
        stopTurnstileCleanup?.();
      } else if (++checks >= 600) {
        stopTurnstileCleanup?.();
      }
    }, 100);

    stopTurnstileCleanup = () => {
      window.clearInterval(timer);
      stopTurnstileCleanup = null;
    };
  };

  const bindTurnstileCleanup = (host: HTMLElement) => {
    const startWatching = (editor: HTMLTextAreaElement | null) => {
      if (editor?.value.trim()) watchForSuccessfulSubmission(host, editor);
    };

    host.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('.wl-btn.primary')) {
        startWatching(
          event.target.closest('.wl-panel')?.querySelector<HTMLTextAreaElement>('.wl-editor') ?? null,
        );
      }
    });

    host.addEventListener('keydown', (event) => {
      if (
        event.target instanceof HTMLTextAreaElement &&
        (event.ctrlKey || event.metaKey) &&
        event.key === 'Enter'
      ) {
        startWatching(event.target);
      }
    });
  };

  const destroyWaline = () => {
    mountGeneration += 1;
    observer?.disconnect();
    observer = null;
    observedHost = null;
    stopTurnstileCleanup?.();
    instance?.destroy();
    instance = null;
    mountedHost = null;
    mountingHost = null;
    mountPromise = null;
  };

  const ensureCommentFonts = () => new Promise<void>((resolve, reject) => {
    const existing = document.querySelector<HTMLLinkElement>('link[data-waline-fonts]');
    if (existing) {
      if (existing.sheet) resolve();
      else {
        existing.addEventListener('load', () => resolve(), { once: true });
        existing.addEventListener('error', () => reject(new Error('Could not load Waline comment fonts.')), { once: true });
      }
      return;
    }

    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/fonts/comment-fonts.css';
    link.dataset.walineFonts = '';
    link.addEventListener('load', () => resolve(), { once: true });
    link.addEventListener('error', () => reject(new Error('Could not load Waline comment fonts.')), { once: true });
    document.head.append(link);
  });

  const ensureWalineStyles = async () => {
    const existing = document.querySelector<HTMLStyleElement>('style[data-waline-styles]');
    if (existing?.textContent?.trim()) return;

    const { default: css } = await import('@waline/client/style?inline');
    const style = existing ?? document.createElement('style');
    style.dataset.walineStyles = '';
    style.textContent = css;
    // Keep Waline's base rules before global.css so the site's comment-theme
    // overrides retain the same cascade as the eager stylesheet did.
    if (!style.isConnected) document.head.prepend(style);
  };

  const mountWaline = (host: HTMLElement) => {
    if (mountedHost === host && instance) return;
    if (mountingHost === host && mountPromise) return mountPromise;
    if (!host.isConnected || host !== document.querySelector('[data-waline-host]')) return;

    destroyWaline();
    const generation = mountGeneration;
    mountingHost = host;

    mountPromise = (async () => {
      const serverURL = host?.dataset.walineServerUrl;
      const path = host?.dataset.walinePath;

      if (!host || !serverURL || !path) return;

      walineClient ??= import('@waline/client');
      const [client] = await Promise.all([
        walineClient,
        ensureWalineStyles(),
      ]);
      void ensureCommentFonts().catch((error) => {
        // A font stylesheet is an enhancement: comments must still work with
        // the system-font fallback if it cannot be loaded.
        console.warn('Could not load Waline comment fonts.', error);
      });
      if (
        generation !== mountGeneration
        || !host.isConnected
        || host !== document.querySelector('[data-waline-host]')
      ) return;

      const { init } = client;

      instance = init({
        el: host,
        serverURL,
        path,
        lang: 'zh-CN',
        meta: ['nick', 'mail'],
        requiredMeta: ['nick', 'mail'],
        login: 'disable',
        commentSorting: 'latest',
        pageview: false,
        reaction: false,
        emoji: [],
        search: false,
        noCopyright: false,
        noRss: true,
        dark: false,
        ...(host.dataset.walineTurnstileKey
          ? { turnstileKey: host.dataset.walineTurnstileKey }
          : {}),
      });

      mountedHost = host;
      applyEmailHint(host);
      bindTurnstileCleanup(host);
      host.setAttribute('aria-busy', 'false');
    })().finally(() => {
      if (generation === mountGeneration) {
        mountingHost = null;
        mountPromise = null;
      }
    });

    return mountPromise;
  };

  const scheduleWaline = () => {
    const host = document.querySelector<HTMLElement>('[data-waline-host]');
    if (!host || !host.dataset.walineServerUrl || !host.dataset.walinePath) {
      destroyWaline();
      return;
    }
    if (
      (mountedHost === host && instance)
      || (mountingHost === host && mountPromise)
      || (observedHost === host && observer)
    ) return;

    destroyWaline();

    host.setAttribute('aria-busy', 'true');
    if (!('IntersectionObserver' in window)) {
      void mountWaline(host);
      return;
    }

    observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer?.disconnect();
      observer = null;
      observedHost = null;
      void mountWaline(host);
    }, { rootMargin: '600px 0px' });
    observedHost = host;
    observer.observe(host);
  };

  scheduleWaline();
  document.addEventListener('astro:page-load', scheduleWaline);
  document.addEventListener('astro:before-swap', destroyWaline);
</script>
