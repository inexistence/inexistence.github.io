---
import manifest from '../generated/responsive-images.json';

interface Candidate {
  width: number;
  webp?: {
    src: string;
    bytes: number;
  };
  avif?: {
    src: string;
    bytes: number;
  };
}

interface ImageEntry {
  width: number;
  height: number;
  candidates: Candidate[];
}

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  pictureClass?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'sync' | 'auto';
  fixedWidth?: number;
  ariaHidden?: boolean;
  reveal?: boolean;
}

const {
  src,
  alt,
  sizes,
  class: className,
  pictureClass,
  loading = 'lazy',
  decoding = 'async',
  fixedWidth,
  ariaHidden = false,
  reveal = false,
} = Astro.props;
const entry = (manifest.images as Record<string, ImageEntry>)[src];
const hasCompleteAvifSet = Boolean(entry?.candidates.length) && entry.candidates.every((candidate) => candidate.avif);
const candidatesFor = (format: 'webp' | 'avif') => {
  if (format === 'avif' && !hasCompleteAvifSet) return [];
  return entry?.candidates.filter((candidate) => candidate[format]) ?? [];
};
const responsiveSource = (format: 'webp' | 'avif') => {
  const candidates = candidatesFor(format);
  const maxCandidateWidth = candidates.at(-1)?.width ?? 0;
  if (!entry || fixedWidth || !candidates.length || maxCandidateWidth < entry.width) return undefined;
  return candidates.map((candidate) => `${candidate[format]?.src} ${candidate.width}w`).join(', ');
};
const fixedSource = (format: 'webp' | 'avif') => {
  if (!fixedWidth) return undefined;
  return candidatesFor(format).find((candidate) => candidate.width >= fixedWidth)?.[format]?.src;
};
const avifResponsive = responsiveSource('avif');
const webpResponsive = responsiveSource('webp');
const avifFixed = fixedSource('avif');
const webpFixed = fixedSource('webp');
---

{entry ? (
  <picture class={pictureClass}>
    {avifResponsive && <source type="image/avif" srcset={avifResponsive} sizes={sizes} />}
    {webpResponsive && <source type="image/webp" srcset={webpResponsive} sizes={sizes} />}
    {avifFixed && <source type="image/avif" srcset={avifFixed} />}
    {webpFixed && <source type="image/webp" srcset={webpFixed} />}
    <img
      src={src}
      alt={alt}
      class={className}
      width={entry.width}
      height={entry.height}
      loading={loading}
      decoding={decoding}
      aria-hidden={ariaHidden ? 'true' : undefined}
      data-reveal={reveal ? '' : undefined}
    />
  </picture>
) : (
  <img
    src={src}
    alt={alt}
    class={className}
    loading={loading}
    decoding={decoding}
    aria-hidden={ariaHidden ? 'true' : undefined}
    data-reveal={reveal ? '' : undefined}
  />
)}
