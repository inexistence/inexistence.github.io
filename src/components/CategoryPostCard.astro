---
import { Card } from 'animal-island-ui/es/components/Card/Card.js';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import { getIslanderForPost } from '../lib/islanders';
import { sharedRemarkPlugins, sharedShikiConfig } from '../lib/markdown-config.mjs';
import { formatDate, getPostIntroMarkdownBlocks, type Post } from '../lib/posts';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  post: Post;
  index: number;
}

const { post, index } = Astro.props;
const islander = getIslanderForPost(post);
const excerptRenderer = await createMarkdownProcessor({
  remarkPlugins: sharedRemarkPlugins,
  shikiConfig: sharedShikiConfig,
});

function addListTruncationHook(html: string) {
  const listItemStart = html.lastIndexOf('<li>');
  const listItemEnd = html.indexOf('</li>', listItemStart);
  if (listItemStart < 0 || listItemEnd < 0) return html;

  const contentStart = listItemStart + '<li>'.length;
  return `${html.slice(0, contentStart)}<span class="category-post-card__list-item-text">${html.slice(contentStart, listItemEnd)}</span>${html.slice(listItemEnd)}`;
}

const introHtmlBlocks = await Promise.all(getPostIntroMarkdownBlocks(post).map(async (block) => {
  const { code } = await excerptRenderer.render(block.markdown);
  const html = block.isTruncated && code.includes('<li>') ? addListTruncationHook(code) : code;
  return { ...block, html };
}));
---

<article class="category-post-card" data-reveal>
  <span class="category-post-card__avatar">
    <img src={islander.avatar} alt="" aria-hidden="true" width="80" height="80" loading="lazy" decoding="async" />
  </span>
  <Card color="default" pattern="none" hoverable className="category-post-card__surface">
    <a class="category-post-card__link" href={`/posts/${post.id}/`} aria-label={`阅读《${post.data.title}》`}></a>
    <div class="category-post-card__body">
      <p class="category-post-card__resident"><strong>{islander.name}</strong><span> · {islander.specialty}</span></p>
      <h2>{post.data.title}</h2>
      <div class="category-post-card__meta">
        <span class="category-post-card__stop">第 {String(index + 1).padStart(2, '0')} 站</span>
        <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
      </div>
      <div class="category-post-card__reading">
        {post.data.cover && (
          <ResponsiveImage
            src={post.data.cover}
            alt=""
            ariaHidden
            pictureClass="category-post-card__cover"
            class="category-post-card__cover-image"
            loading="lazy"
            sizes="(max-width: 760px) calc(100vw - 72px), 560px"
          />
        )}
        <div class="category-post-card__intro prose">
          {introHtmlBlocks.map(({ html, isTruncated }) => (
            <div class:list={['category-post-card__intro-block', { 'category-post-card__intro-block--truncated': isTruncated }]} set:html={html}></div>
          ))}
        </div>
        <span class="category-post-card__more">继续阅读正文 <span aria-hidden="true">→</span></span>
      </div>
    </div>
  </Card>
</article>
