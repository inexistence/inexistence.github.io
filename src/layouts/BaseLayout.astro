---
import { ClientRouter } from 'astro:transitions';
import '../styles/animal-island-base.css';
import '../styles/animal-island-components.css';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title = 'INEXISTENCE',
  description = '这里收着一些技术笔记、生活碎片，还有舍不得忘记的旧事。',
  image = '/assets/images/cover.jpg',
  noindex = false,
  bodyClass,
} = Astro.props;
const pageTitle = title === 'INEXISTENCE' ? title : `${title} · INEXISTENCE`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <ClientRouter />
    <style is:inline data-waline-styles data-astro-transition-persist="waline-styles"></style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#8ec7a0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="INEXISTENCE RSS" href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      (() => {
        if (window.__inexistenceRevealControllerInstalled) return;
        window.__inexistenceRevealControllerInstalled = true;

        let observer;
        let shouldFocusMain = false;

        const cleanup = () => {
          observer?.disconnect();
          observer = undefined;
        };

        const initializeRevealItems = () => {
          cleanup();

          const revealItems = document.querySelectorAll('[data-reveal]');
          const root = document.documentElement;
          root.classList.add('js');

          if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            root.classList.add('reveal-ready');
            // Commit the hidden state before IntersectionObserver can reveal
            // above-the-fold items during the same router swap.
            void root.offsetWidth;
            observer = new IntersectionObserver((entries, activeObserver) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  activeObserver.unobserve(entry.target);
                }
              }
            }, { threshold: 0.01, rootMargin: '0px 0px -4% 0px' });
            revealItems.forEach((item) => observer.observe(item));
          } else {
            root.classList.remove('reveal-ready');
            revealItems.forEach((item) => item.classList.add('is-visible'));
          }
        };

        initializeRevealItems();
        document.addEventListener('astro:before-swap', (event) => {
          cleanup();
          shouldFocusMain = event.navigationType !== 'traverse';
        });
        document.addEventListener('astro:after-swap', () => {
          initializeRevealItems();
          if (shouldFocusMain) {
            document.querySelector('#main-content')?.focus({ preventScroll: true });
          }
        });
      })();
    </script>
  </body>
</html>
